{
  "$defs": {
    "Assessment": {
      "type": "string",
      "enum": [
        "strong",
        "favorable",
        "neutral",
        "weak",
        "poor",
        "not_assessed"
      ],
      "title": "Assessment"
    },
    "Category": {
      "type": "string",
      "enum": [
        "valuation",
        "profitability",
        "non_operating",
        "leverage",
        "cash_flow_quality",
        "growth",
        "ownership",
        "context"
      ],
      "title": "Category"
    },
    "Context": {
      "type": "object",
      "title": "Context",
      "properties": {
        "requested": {
          "type": "boolean",
          "description": "false when the context category was not requested; other fields then empty/0",
          "title": "Requested"
        },
        "industry": {
          "type": "string",
          "title": "Industry"
        },
        "peer_set_used": {
          "type": "array",
          "title": "Peer Set Used",
          "items": {
            "type": "string"
          }
        },
        "segment_notes": {
          "type": "string",
          "title": "Segment Notes"
        },
        "management_commentary": {
          "type": "string",
          "title": "Management Commentary"
        },
        "dividend_policy": {
          "type": "string",
          "title": "Dividend Policy"
        },
        "accounting_flags": {
          "type": "string",
          "description": "Restatements, auditor notes, off-balance-sheet items; empty if none",
          "title": "Accounting Flags"
        },
        "reliability_pct": {
          "type": "integer",
          "title": "Reliability Pct",
          "description": "{maximum: 100, minimum: 0}"
        }
      },
      "additionalProperties": false,
      "required": [
        "requested",
        "industry",
        "peer_set_used",
        "segment_notes",
        "management_commentary",
        "dividend_policy",
        "accounting_flags",
        "reliability_pct"
      ]
    },
    "DataGap": {
      "type": "object",
      "title": "DataGap",
      "properties": {
        "measure_id": {
          "type": "string",
          "description": "A measure id from the catalogue, or empty string for a general gap",
          "title": "Measure Id"
        },
        "description": {
          "type": "string",
          "title": "Description"
        }
      },
      "additionalProperties": false,
      "required": [
        "measure_id",
        "description"
      ]
    },
    "DataMode": {
      "type": "string",
      "enum": [
        "supplied",
        "retrieved",
        "mixed",
        "recall_only"
      ],
      "title": "DataMode"
    },
    "DataPoint": {
      "type": "object",
      "title": "DataPoint",
      "properties": {
        "period_end": {
          "type": "string",
          "description": "ISO date of the period end (or snapshot date)",
          "title": "Period End"
        },
        "period_type": {
          "$ref": "#/$defs/PeriodType"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "In the reporting currency; null when unavailable; never invent a number",
          "title": "Value"
        },
        "value_base": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "value converted into the request's base_currency (flows at the period's average rate, balance-sheet items at the closing rate, point-in-time items at spot); null when no base_currency, when value is null, or when the unit is not currency/per_share",
          "title": "Value Base"
        },
        "reliability_pct": {
          "type": "integer",
          "description": "0-100 per the rubric in the system prompt\n\n{maximum: 100, minimum: 0}",
          "title": "Reliability Pct"
        },
        "method": {
          "$ref": "#/$defs/Method"
        },
        "source_ids": {
          "type": "array",
          "description": "ids from `sources`; empty only when method is unavailable",
          "title": "Source Ids",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "period_end",
        "period_type",
        "value",
        "value_base",
        "reliability_pct",
        "method",
        "source_ids"
      ]
    },
    "Direction": {
      "type": "string",
      "enum": [
        "improving",
        "stable",
        "deteriorating",
        "volatile",
        "insufficient_data"
      ],
      "title": "Direction"
    },
    "Fx": {
      "type": "object",
      "title": "Fx",
      "properties": {
        "reporting_currency": {
          "type": "string",
          "description": "ISO 4217 of the financial statements",
          "title": "Reporting Currency"
        },
        "base_currency": {
          "type": "string",
          "description": "ISO 4217 from the request, or empty when none was given",
          "title": "Base Currency"
        },
        "rates": {
          "type": "array",
          "description": "One entry per period in the series; empty when no base_currency",
          "title": "Rates",
          "items": {
            "$ref": "#/$defs/FxRate"
          }
        },
        "method_note": {
          "type": "string",
          "description": "Rate source (e.g. ECB reference rates), how averages were formed, caveats",
          "title": "Method Note"
        }
      },
      "additionalProperties": false,
      "required": [
        "reporting_currency",
        "base_currency",
        "rates",
        "method_note"
      ]
    },
    "FxRate": {
      "type": "object",
      "title": "FxRate",
      "properties": {
        "period_end": {
          "type": "string",
          "description": "ISO date of the fiscal period end or snapshot date",
          "title": "Period End"
        },
        "period_type": {
          "$ref": "#/$defs/PeriodType"
        },
        "average_rate": {
          "type": "number",
          "description": "Units of base currency per 1 unit of reporting currency, period average",
          "title": "Average Rate"
        },
        "closing_rate": {
          "type": "number",
          "description": "Units of base currency per 1 unit of reporting currency at period end",
          "title": "Closing Rate"
        },
        "source_ids": {
          "type": "array",
          "title": "Source Ids",
          "items": {
            "type": "string"
          }
        },
        "reliability_pct": {
          "type": "integer",
          "title": "Reliability Pct",
          "description": "{maximum: 100, minimum: 0}"
        }
      },
      "additionalProperties": false,
      "required": [
        "period_end",
        "period_type",
        "average_rate",
        "closing_rate",
        "source_ids",
        "reliability_pct"
      ]
    },
    "Holder": {
      "type": "object",
      "title": "Holder",
      "properties": {
        "name": {
          "type": "string",
          "title": "Name"
        },
        "pct_of_shares": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Pct Of Shares"
        },
        "holder_type": {
          "type": "string",
          "enum": [
            "institution",
            "insider",
            "strategic",
            "fund",
            "other"
          ],
          "title": "Holder Type"
        },
        "as_of": {
          "type": "string",
          "description": "ISO date of the holding snapshot; empty if unknown",
          "title": "As Of"
        },
        "reliability_pct": {
          "type": "integer",
          "title": "Reliability Pct",
          "description": "{maximum: 100, minimum: 0}"
        },
        "source_ids": {
          "type": "array",
          "title": "Source Ids",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "pct_of_shares",
        "holder_type",
        "as_of",
        "reliability_pct",
        "source_ids"
      ]
    },
    "Inflection": {
      "type": "object",
      "title": "Inflection",
      "properties": {
        "measure_id": {
          "$ref": "#/$defs/MeasureId"
        },
        "period_end": {
          "type": "string",
          "title": "Period End"
        },
        "description": {
          "type": "string",
          "title": "Description"
        }
      },
      "additionalProperties": false,
      "required": [
        "measure_id",
        "period_end",
        "description"
      ]
    },
    "Measure": {
      "type": "object",
      "title": "Measure",
      "properties": {
        "measure_id": {
          "$ref": "#/$defs/MeasureId"
        },
        "category": {
          "$ref": "#/$defs/Category"
        },
        "label": {
          "type": "string",
          "title": "Label"
        },
        "unit": {
          "$ref": "#/$defs/Unit"
        },
        "currency": {
          "type": "string",
          "description": "ISO 4217 when unit is currency/per_share, else empty string",
          "title": "Currency"
        },
        "scale": {
          "$ref": "#/$defs/Scale"
        },
        "latest": {
          "$ref": "#/$defs/DataPoint"
        },
        "series": {
          "type": "array",
          "description": "Chronological, oldest first, within the requested period",
          "title": "Series",
          "items": {
            "$ref": "#/$defs/DataPoint"
          }
        },
        "trend": {
          "$ref": "#/$defs/Trend"
        },
        "reliability_pct": {
          "type": "integer",
          "description": "Overall reliability of this measure\n\n{maximum: 100, minimum: 0}",
          "title": "Reliability Pct"
        },
        "reliability_basis": {
          "type": "string",
          "description": "Why this reliability: source quality, period alignment, assumptions",
          "title": "Reliability Basis"
        },
        "notes": {
          "type": "string",
          "description": "Caveats, failed F-Score tests, discrepancies; empty if none",
          "title": "Notes"
        }
      },
      "additionalProperties": false,
      "required": [
        "measure_id",
        "category",
        "label",
        "unit",
        "currency",
        "scale",
        "latest",
        "series",
        "trend",
        "reliability_pct",
        "reliability_basis",
        "notes"
      ]
    },
    "MeasureId": {
      "type": "string",
      "description": "A measure id from the catalogue in the system prompt"
    },
    "Method": {
      "type": "string",
      "enum": [
        "reported",
        "derived",
        "estimated",
        "unavailable"
      ],
      "title": "Method"
    },
    "Ownership": {
      "type": "object",
      "title": "Ownership",
      "properties": {
        "requested": {
          "type": "boolean",
          "description": "false when the ownership category was not requested; other fields then empty/0",
          "title": "Requested"
        },
        "top_holders": {
          "type": "array",
          "title": "Top Holders",
          "items": {
            "$ref": "#/$defs/Holder"
          }
        },
        "recent_insider_activity": {
          "type": "string",
          "description": "Summary of buys/sells in the period; empty if none/unknown",
          "title": "Recent Insider Activity"
        },
        "reliability_pct": {
          "type": "integer",
          "title": "Reliability Pct",
          "description": "{maximum: 100, minimum: 0}"
        },
        "notes": {
          "type": "string",
          "title": "Notes"
        }
      },
      "additionalProperties": false,
      "required": [
        "requested",
        "top_holders",
        "recent_insider_activity",
        "reliability_pct",
        "notes"
      ]
    },
    "PeerComparison": {
      "type": "string",
      "enum": [
        "better",
        "in_line",
        "worse",
        "unknown"
      ],
      "title": "PeerComparison"
    },
    "PeriodType": {
      "type": "string",
      "enum": [
        "FY",
        "Q",
        "TTM",
        "FWD",
        "POINT"
      ],
      "title": "PeriodType"
    },
    "Pillar": {
      "type": "object",
      "title": "Pillar",
      "properties": {
        "pillar": {
          "$ref": "#/$defs/PillarId"
        },
        "assessment": {
          "$ref": "#/$defs/Assessment"
        },
        "score_0_100": {
          "type": "integer",
          "description": "100 = most favourable for a long position\n\n{maximum: 100, minimum: 0}",
          "title": "Score 0 100"
        },
        "key_measures": {
          "type": "array",
          "title": "Key Measures",
          "items": {
            "$ref": "#/$defs/MeasureId"
          }
        },
        "rationale": {
          "type": "string",
          "title": "Rationale"
        },
        "reliability_pct": {
          "type": "integer",
          "title": "Reliability Pct",
          "description": "{maximum: 100, minimum: 0}"
        }
      },
      "additionalProperties": false,
      "required": [
        "pillar",
        "assessment",
        "score_0_100",
        "key_measures",
        "rationale",
        "reliability_pct"
      ]
    },
    "PillarId": {
      "type": "string",
      "enum": [
        "valuation",
        "profitability_stability",
        "debt_health",
        "earnings_quality",
        "trends"
      ],
      "title": "PillarId"
    },
    "PillarScores": {
      "type": "object",
      "description": "Point-in-time pillar scores, 0-100 (100 = most favourable); 0 with `valuation_assessed` false\nwhen valuation could not be assessed for that date.",
      "title": "PillarScores",
      "properties": {
        "valuation": {
          "type": "integer",
          "title": "Valuation",
          "description": "{maximum: 100, minimum: 0}"
        },
        "profitability_stability": {
          "type": "integer",
          "title": "Profitability Stability",
          "description": "{maximum: 100, minimum: 0}"
        },
        "debt_health": {
          "type": "integer",
          "title": "Debt Health",
          "description": "{maximum: 100, minimum: 0}"
        },
        "earnings_quality": {
          "type": "integer",
          "title": "Earnings Quality",
          "description": "{maximum: 100, minimum: 0}"
        },
        "trends": {
          "type": "integer",
          "title": "Trends",
          "description": "{maximum: 100, minimum: 0}"
        }
      },
      "additionalProperties": false,
      "required": [
        "valuation",
        "profitability_stability",
        "debt_health",
        "earnings_quality",
        "trends"
      ]
    },
    "RelativePosition": {
      "type": "string",
      "enum": [
        "bottom_quartile",
        "below_median",
        "above_median",
        "top_quartile",
        "unknown"
      ],
      "title": "RelativePosition"
    },
    "Scale": {
      "type": "string",
      "enum": [
        "units",
        "thousands",
        "millions",
        "billions",
        "not_applicable"
      ],
      "title": "Scale"
    },
    "Signal": {
      "type": "string",
      "enum": [
        "extreme_buy",
        "buy",
        "hold",
        "sell",
        "extreme_sell"
      ],
      "title": "Signal"
    },
    "SignalBlock": {
      "type": "object",
      "title": "SignalBlock",
      "properties": {
        "category": {
          "$ref": "#/$defs/Signal"
        },
        "conviction_pct": {
          "type": "integer",
          "description": "How strongly the evidence supports the category\n\n{maximum: 100, minimum: 0}",
          "title": "Conviction Pct"
        },
        "reliability_pct": {
          "type": "integer",
          "description": "Bounded by the reliability of the inputs\n\n{maximum: 100, minimum: 0}",
          "title": "Reliability Pct"
        },
        "rationale": {
          "type": "string",
          "title": "Rationale"
        },
        "green_flags": {
          "type": "array",
          "title": "Green Flags",
          "items": {
            "type": "string"
          }
        },
        "red_flags": {
          "type": "array",
          "title": "Red Flags",
          "items": {
            "type": "string"
          }
        },
        "conditions_for_upgrade": {
          "type": "array",
          "title": "Conditions For Upgrade",
          "items": {
            "type": "string"
          }
        },
        "conditions_for_downgrade": {
          "type": "array",
          "title": "Conditions For Downgrade",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "category",
        "conviction_pct",
        "reliability_pct",
        "rationale",
        "green_flags",
        "red_flags",
        "conditions_for_upgrade",
        "conditions_for_downgrade"
      ]
    },
    "SignalPoint": {
      "type": "object",
      "description": "The framework applied as of `period_end`, using only information available at that date.",
      "title": "SignalPoint",
      "properties": {
        "period_end": {
          "type": "string",
          "title": "Period End"
        },
        "period_type": {
          "$ref": "#/$defs/PeriodType"
        },
        "category": {
          "$ref": "#/$defs/Signal"
        },
        "conviction_pct": {
          "type": "integer",
          "title": "Conviction Pct",
          "description": "{maximum: 100, minimum: 0}"
        },
        "reliability_pct": {
          "type": "integer",
          "title": "Reliability Pct",
          "description": "{maximum: 100, minimum: 0}"
        },
        "valuation_assessed": {
          "type": "boolean",
          "description": "false when no price/multiples for that date; extreme categories then unavailable",
          "title": "Valuation Assessed"
        },
        "pillar_scores": {
          "$ref": "#/$defs/PillarScores"
        },
        "decisive_factor": {
          "type": "string",
          "description": "One sentence: what drove the category at that date",
          "title": "Decisive Factor"
        },
        "source_ids": {
          "type": "array",
          "description": "Sources for the point-in-time price and any as-of figures",
          "title": "Source Ids",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "period_end",
        "period_type",
        "category",
        "conviction_pct",
        "reliability_pct",
        "valuation_assessed",
        "pillar_scores",
        "decisive_factor",
        "source_ids"
      ]
    },
    "Source": {
      "type": "object",
      "title": "Source",
      "properties": {
        "id": {
          "type": "string",
          "description": "Short handle referenced by data points, e.g. S1",
          "title": "Id"
        },
        "type": {
          "$ref": "#/$defs/SourceType"
        },
        "title": {
          "type": "string",
          "title": "Title"
        },
        "url": {
          "type": "string",
          "description": "URL, or empty string for supplied input / recall",
          "title": "Url"
        },
        "period_covered": {
          "type": "string",
          "description": "e.g. 'FY2024 10-K', 'as of 2025-09-30'; empty if unknown",
          "title": "Period Covered"
        },
        "retrieved_at": {
          "type": "string",
          "description": "ISO date the page was fetched; empty for supplied/recall",
          "title": "Retrieved At"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "title",
        "url",
        "period_covered",
        "retrieved_at"
      ]
    },
    "SourceType": {
      "type": "string",
      "enum": [
        "primary_filing",
        "company_ir",
        "aggregator",
        "supplied_input",
        "supplied_screenshot",
        "web_other",
        "model_recall"
      ],
      "title": "SourceType"
    },
    "Trend": {
      "type": "object",
      "title": "Trend",
      "properties": {
        "direction": {
          "$ref": "#/$defs/Direction"
        },
        "cagr_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Compound annual growth rate over the series, % per year",
          "title": "Cagr Pct"
        },
        "latest_yoy_change_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Latest Yoy Change Pct"
        },
        "coefficient_of_variation": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "stdev / mean of the series, as a ratio",
          "title": "Coefficient Of Variation"
        },
        "vs_own_history": {
          "$ref": "#/$defs/RelativePosition"
        },
        "vs_peers": {
          "$ref": "#/$defs/PeerComparison"
        },
        "reliability_pct": {
          "type": "integer",
          "title": "Reliability Pct",
          "description": "{maximum: 100, minimum: 0}"
        },
        "comment": {
          "type": "string",
          "description": "One or two sentences; what drives the trend",
          "title": "Comment"
        }
      },
      "additionalProperties": false,
      "required": [
        "direction",
        "cagr_pct",
        "latest_yoy_change_pct",
        "coefficient_of_variation",
        "vs_own_history",
        "vs_peers",
        "reliability_pct",
        "comment"
      ]
    },
    "TrendSummary": {
      "type": "object",
      "title": "TrendSummary",
      "properties": {
        "overall_direction": {
          "$ref": "#/$defs/Direction"
        },
        "improving": {
          "type": "array",
          "title": "Improving",
          "items": {
            "$ref": "#/$defs/MeasureId"
          }
        },
        "stable": {
          "type": "array",
          "title": "Stable",
          "items": {
            "$ref": "#/$defs/MeasureId"
          }
        },
        "deteriorating": {
          "type": "array",
          "title": "Deteriorating",
          "items": {
            "$ref": "#/$defs/MeasureId"
          }
        },
        "inflections": {
          "type": "array",
          "title": "Inflections",
          "items": {
            "$ref": "#/$defs/Inflection"
          }
        },
        "operating_vs_non_operating": {
          "type": "string",
          "description": "Whether core operating performance differs from reported results",
          "title": "Operating Vs Non Operating"
        },
        "reliability_pct": {
          "type": "integer",
          "title": "Reliability Pct",
          "description": "{maximum: 100, minimum: 0}"
        }
      },
      "additionalProperties": false,
      "required": [
        "overall_direction",
        "improving",
        "stable",
        "deteriorating",
        "inflections",
        "operating_vs_non_operating",
        "reliability_pct"
      ]
    },
    "Unit": {
      "type": "string",
      "enum": [
        "currency",
        "percent",
        "ratio",
        "multiple",
        "count",
        "score",
        "per_share"
      ],
      "title": "Unit"
    }
  },
  "type": "object",
  "title": "AnalysisResponse",
  "properties": {
    "schema_version": {
      "type": "string",
      "title": "Schema Version",
      "description": "{const: 1.0}"
    },
    "symbol": {
      "type": "string",
      "description": "Symbol as given in the request",
      "title": "Symbol"
    },
    "company_name": {
      "type": "string",
      "description": "Empty string if unknown",
      "title": "Company Name"
    },
    "analysis_date": {
      "type": "string",
