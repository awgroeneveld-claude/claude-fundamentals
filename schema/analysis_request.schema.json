{
  "$defs": {
    "Category": {
      "enum": [
        "valuation",
        "profitability",
        "non_operating",
        "leverage",
        "cash_flow_quality",
        "growth",
        "ownership",
        "context"
      ],
      "title": "Category",
      "type": "string"
    },
    "Frequency": {
      "enum": [
        "annual",
        "quarterly",
        "both"
      ],
      "title": "Frequency",
      "type": "string"
    },
    "ImageAttachment": {
      "additionalProperties": false,
      "description": "A screenshot (e.g. Interactive Brokers fundamentals / ownership pages) sent as an image block.\n\nProvide either `path` (resolved by the CLI relative to the request file) or `data` (base64).\nSupported: image/png, image/jpeg, image/gif, image/webp; <= 5 MB each, at most 100 per request.\nKeep the long edge <= 1568 px: larger images are downscaled server-side anyway.",
      "properties": {
        "media_type": {
          "default": "image/png",
          "enum": [
            "image/png",
            "image/jpeg",
            "image/gif",
            "image/webp"
          ],
          "title": "Media Type",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "File path; the CLI reads and base64-encodes it",
          "title": "Path"
        },
        "data": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Base64-encoded image bytes (no data: prefix)",
          "title": "Data"
        },
        "caption": {
          "description": "What the image shows and when it was captured, e.g. 'IB TWS > Fundamentals > Financial Summary, annual, captured 2026-10-20'",
          "title": "Caption",
          "type": "string"
        }
      },
      "required": [
        "caption"
      ],
      "title": "ImageAttachment",
      "type": "object"
    },
    "MeasureId": {
      "description": "A measure id from the catalogue in the system prompt",
      "type": "string"
    },
    "Period": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "description": "ISO date, inclusive, e.g. 2016-01-01",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "description": "ISO date, inclusive, e.g. 2025-12-31",
          "title": "End",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "Period",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "symbol": {
      "description": "Ticker symbol, e.g. AAPL, ASML, 'ASML.AS'",
      "title": "Symbol",
      "type": "string"
    },
    "exchange": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Exchange hint, e.g. NASDAQ, Euronext Amsterdam",
      "title": "Exchange"
    },
    "company_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Company Name"
    },
    "reporting_currency": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "ISO 4217, e.g. USD, EUR",
      "title": "Reporting Currency"
    },
    "period": {
      "$ref": "#/$defs/Period"
    },
    "frequency": {
      "$ref": "#/$defs/Frequency",
      "default": "annual"
    },
    "categories": {
      "description": "Subset of the framework's data categories to analyse.",
      "items": {
        "$ref": "#/$defs/Category"
      },
      "title": "Categories",
      "type": "array"
    },
    "measures": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/MeasureId"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Optional whitelist of measure ids. When set, only these are produced (plus whatever the signal needs, flagged in notes).",
      "title": "Measures"
    },
    "peer_symbols": {
      "items": {
        "type": "string"
      },
      "title": "Peer Symbols",
      "type": "array"
    },
    "sector_hint": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "e.g. 'regulated utility', 'enterprise software'",
      "title": "Sector Hint"
    },
    "allow_web_research": {
      "default": true,
      "description": "Let Claude use the web_search / web_fetch server tools to gather figures.",
      "title": "Allow Web Research",
      "type": "boolean"
    },
    "supplied_data": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Raw financial-statement data from your own provider (any JSON shape; describe units/periods inside it). When present, it is the preferred source.",
      "title": "Supplied Data"
    },
    "images": {
      "description": "Screenshots to read figures from; sent as image blocks, not inside the JSON payload.",
      "items": {
        "$ref": "#/$defs/ImageAttachment"
      },
      "title": "Images",
      "type": "array"
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Free-text instructions within the framework's scope.",
      "title": "Notes"
    }
  },
  "required": [
    "symbol",
    "period"
  ],
  "title": "AnalysisRequest",
  "type": "object"
}
